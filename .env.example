# Client-side (published to browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Server-side (Vercel / Lovable env variables — NOT in client bundle)
# These are required for server-functions (checkout, demo showcase) that
# call supabaseAdmin (service role). Get SERVICE ROLE KEY from Supabase
# → Project Settings → API → service_role secret key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# AI / billing
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_live_...

# Edge function webhook security (welcome-interceptor)
SUPABASE_WEBHOOK_SECRET=whsec_...
