# Client-side (published to the browser bundle via Vite)
# Safe to expose; these are read by the client app.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# VAPID public key used by the client for push subscription.
# Only the PUBLIC key goes here — never the private key.
VITE_VAPID_PUBLIC_KEY=BNw... (base64url public key)

# -----------------------------------------------------------------------------
# Server-side (Vercel / Lovable environment variables — NOT in the client bundle)
# These must be set in your Vercel project settings (or .env locally). They are
# read by server functions / cron routes at runtime.
# -----------------------------------------------------------------------------

# Supabase (service role for server-side/admin operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# VAPID keys for server-side push notifications (send-4pm-push cron).
# The PRIVATE key must never be VITE_ prefixed (that would publish it to the browser).
VAPID_PRIVATE_KEY=_T_M43a... (base64url private key)
VAPID_SUBJECT=mailto:admin@apexmissions.app

# AI / billing
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_live_...

# AI model routing
AI_BASELINE_MODEL=...
AI_ASTRA_MODEL=...
AI_BASELINE_MAX_TOKENS=...
AI_ASTRA_MAX_TOKENS=...
AI_ASTRA_REASONING_EFFORT=...
AI_BASELINE_TIMEOUT_MS=...
AI_ASTRA_TIMEOUT_MS=...

# Cron security
LOVABLE_CRON_SECRET=...
LOVABLE_CRON_SECRET_PREVIOUS=...
LOVABLE_API_KEY=...
CRON_SECRET=...

# S3 export (enterprise)
S3_EXPORT_BUCKET=...
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=...
S3_SECRET_ACCESS_KEY=...

# Resend (email)
RESEND_API_KEY=...
RESEND_FROM_EMAIL=noreply@apexmissions.app

# Edge function webhook security (welcome-interceptor)
SUPABASE_WEBHOOK_SECRET=whsec_...

# Tenant root domain (server.ts)
TENANT_ROOT_DOMAIN=apexmissions.app
